{
  "name": "fb-page-telegram-notifier",
  "version": "1.1.0",
  "description": "Telegram notifications for Facebook Page messages and view milestones (500–200k)",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "vercel:dev": "vercel dev",
    "telegram:set-webhook": "node scripts/set-telegram-webhook.js",
    "telegram:set-commands": "node scripts/set-telegram-commands.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "facebook",
    "telegram",
    "webhook",
    "vercel"
  ],
  "license": "MIT",
  "dependencies": {
    "@upstash/redis": "^1.41.1",
    "@vercel/functions": "^2.0.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "vercel": "^39.0.0"
  }
}
