# --- Facebook ---
GRAPH_VERSION=v26.0
FB_LONG_USER_TOKEN=
# Meta App → Settings → Basic (cần để đăng ký webhook Page qua Graph API)
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=

# --- Telegram ---
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- URLs (production: https://your-app.vercel.app) ---
PUBLIC_BASE_URL=

# Cron: Vercel gửi Authorization Bearer <CRON_SECRET> — nên set chuỗi ngẫu nhiên
CRON_SECRET=

# --- Local only (npm start / npm run dev) ---
PORT=3000
CHECK_INTERVAL_MINUTES=5
RECENT_POSTS_PER_PAGE=10
PAGE_SCAN_CONCURRENCY=8

# --- Redis (Vercel: Marketplace → Upstash Redis → Connect project) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Hoặc tên cũ từ KV legacy:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=