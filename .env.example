PORT=3000
GRAPH_VERSION=v26.0

# Facebook: long-lived user token (User Token with pages_show_list, pages_read_engagement, pages_messaging)
FB_LONG_USER_TOKEN=
# Must match the verify token in Meta App → Webhooks
FB_VERIFY_TOKEN=

# Telegram
TG_BOT_TOKEN=
# Chat ID to receive notifications (get from @userinfobot or similar)
TG_CHAT_ID=

# How often to scan posts for 500 / 1k view milestones (0 = disable periodic scan)
CHECK_INTERVAL_MINUTES=5

# Public HTTPS base URL for webhooks (no trailing slash), e.g. https://your-app.railway.app
PUBLIC_BASE_URL=